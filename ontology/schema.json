{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BONES.OTF anatomy registry",
  "type": "object",
  "required": ["version", "namespace", "objects"],
  "properties": {
    "version": {"type": "string"},
    "namespace": {"const": "anatomy"},
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "category", "system", "unicode_pua", "ligature", "shortcode", "glyph", "external_ids"],
        "properties": {
          "id": {"pattern": "^anatomy:[a-z0-9_]+$"},
          "label": {"type": "string", "minLength": 1},
          "category": {"enum": ["bone", "organ", "tissue"]},
          "system": {"type": "string", "minLength": 1},
          "unicode_pua": {"pattern": "^E[0-9A-F]{3,5}$"},
          "ligature": {"pattern": "^:[a-z0-9_]+:$"},
          "shortcode": {"pattern": "^:[a-z0-9_]+:$"},
          "glyph": {"type": "object", "required": ["monochrome", "color", "base"]},
          "external_ids": {"type": "object"}
        }
      }
    }
  }
}

